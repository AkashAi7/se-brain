# Legacy SE Graph Wiki MCP — Environment Variables
# Copy this to .env only if you need migration-only SharePoint backfill.
# The active shared raw source store is Azure DevOps:
# https://dev.azure.com/SE-Brain-AzDev/SE-Brain

# SharePoint site hostname (your tenant)
GRAPH_SITE_HOSTNAME=microsoft.sharepoint.com

# SharePoint site path (the site where wiki content lives)
# Create a SharePoint site for this, e.g. /sites/SE-Brain-Wiki
GRAPH_SITE_PATH=/sites/SE-Brain-Wiki

# Document library name within the site (default: "Documents")
GRAPH_LIBRARY_NAME=Documents

# Authentication: DefaultAzureCredential is used automatically.
# It tries these in order:
#   1. Environment variables (AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_CLIENT_SECRET)
#   2. Azure CLI login (az login) ← easiest for local dev
#   3. Visual Studio Code credential
#   4. Managed Identity (for deployed services)
#
# For local development, just run:
#   az login
# And ensure your account has Files.ReadWrite.All or Sites.ReadWrite.All permissions.
