{
  "version": "1.0",
  "description": "Tracks individual SE progress through onboarding phases",
  "schema": {
    "se_alias": "string (corp alias)",
    "start_date": "ISO date",
    "current_phase": "phase-1 | phase-2 | phase-3 | phase-4 | phase-5",
    "role_track": "infra | data | software | ai",
    "sector": "dn | ps | manufacturing | itus",
    "pod": "pod-01 | pod-02",
    "manager": "string (manager alias)",
    "buddy": "string (buddy alias)",
    "completed_tasks": ["task_id array"],
    "certifications": [{"cert": "string", "status": "planned | in-progress | completed", "date": "ISO date or null"}],
    "checkpoints": {
      "day_30": {"status": "pending | complete", "date": null, "notes": ""},
      "day_60": {"status": "pending | complete", "date": null, "notes": ""},
      "day_90": {"status": "pending | complete", "date": null, "notes": ""}
    }
  },
  "example": {
    "se_alias": "akashdwivedi",
    "start_date": "2026-05-01",
    "current_phase": "phase-4-customer-readiness",
    "role_track": "ai",
    "sector": "itus",
    "pod": "pod-01",
    "manager": "ashishar",
    "buddy": null,
    "completed_tasks": ["p1-01", "p1-02", "p1-03"],
    "certifications": [
      {"cert": "AI-900", "status": "completed", "date": "2026-05-28"},
      {"cert": "AZ-900", "status": "in-progress", "date": null}
    ],
    "checkpoints": {
      "day_30": {"status": "complete", "date": "2026-06-01", "notes": "On track"},
      "day_60": {"status": "pending", "date": null, "notes": ""},
      "day_90": {"status": "pending", "date": null, "notes": ""}
    }
  }
}
