{
  "mcpServers": {
    "microsoft/azure-devops-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@latest",
        "SE-Brain-AzDev",
        "-d",
        "all",
        "-a",
        "interactive"
      ]
    },
    "workiq": {
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/workiq@latest",
        "mcp"
      ]
    }
  }
}