{
  "servers": {
    "microsoft/azure-devops-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@latest",
        "SE-Brain-AzDev",
        "-d",
        "all",
        "-a",
        "interactive"
      ],
      "gallery": "https://api.mcp.github.com",
      "version": "1.0.0"
    },
    "workiq": {
      "command": "npx",
      "args": ["-y", "@microsoft/workiq@latest", "mcp"]
    }
  }
}
